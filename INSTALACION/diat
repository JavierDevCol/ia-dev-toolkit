def cmd_update():
    """Actualizar el toolkit y reinstalar en proyectos registrados."""
    print_banner()

    # 1. Obtener versión remota
    remote_version = get_remote_version()

    # 2. Actualizar CLI diat
    print(f"  📦 Actualizando CLI diat...")
    diat_path = Path(__file__).resolve()
    diat_url = "https://raw.githubusercontent.com/JavierDevCol/ia-dev-toolkit/main/INSTALACION/diat"

    try:
        import urllib.request
        req = urllib.request.Request(diat_url, headers={"User-Agent": "diat-cli"})
        response = urllib.request.urlopen(req, timeout=30)
        new_diat = response.read()

        backup_path = diat_path.with_suffix(".bak")
        backup_path.write_bytes(diat_path.read_bytes())

        diat_path.write_bytes(new_diat)
        diat_path.chmod(0o755)
        print(f"  ✅ CLI diat actualizado")
    except Exception as e:
        print(f"  ⚠️  No se pudo actualizar diat: {e}")

    # 3. Guardar versión instalada
    if remote_version:
        save_installed_version(remote_version)
        print(f"  📌 Versión instalada: {remote_version}")

    # 4. Actualizar cache de componentes
    temp_repo_path = get_temp_repo_path()
    if temp_repo_path.exists():
        print(f"\n  🗑️  Eliminando cache anterior...")
        import shutil
        shutil.rmtree(temp_repo_path)

    instalar_dir = ensure_instalar()
    if not instalar_dir:
        print(f"\n  ❌ No se pudo obtener instalar.py")
        return

    sys.path.insert(0, instalar_dir)
    try:
        from instalar import download_from_github
        result = download_from_github(temp_repo_path)
        if result:
            print(f"\n  ✅ Componentes descargados")
        else:
            print(f"\n  ❌ Error al descargar componentes")
            return
    except Exception as e:
        print(f"\n  ❌ Error: {e}")
        return

    # 5. Reinstalar en proyectos registrados
    installations = load_installations()

    if not installations:
        print(f"\n  ℹ️  No hay instalaciones registradas")
        print(f"     Ejecuta `diat --install /ruta/proyecto` para registrar")
    else:
        print(f"\n  📋 Reinstalando en {len(installations)} proyecto(s) registrado(s)...")

        for inst in installations:
            project_path = Path(inst["project_path"])
            if project_path.exists():
                print(f"\n  📦 {project_path}...")
                reinstall_components(inst, temp_repo_path)
            else:
                print(f"\n  ⚠️  Proyecto no encontrado: {project_path}")

    # 6. Actualizar versión en instalacion.json
    if remote_version:
        update_installations_version(remote_version)

    print(f"\n{'═' * 70}")
    print(f"  ✅ ACTUALIZACIÓN COMPLETADA")
    print(f"{'═' * 70}")
    print(f"\n  ⚠️  Reinicia la terminal o ejecuta: diat --version\n")


def cmd_install():
    """Instalar componentes en un proyecto."""
    non_interactive = "--non-interactive" in sys.argv or "-ni" in sys.argv

    # Determinar ruta
    if len(sys.argv) > 2 and not sys.argv[2].startswith("-"):
        project_path = Path(sys.argv[2]).resolve()
    else:
        # Sin ruta — instalación global
        print_banner()
        print(f"  ⚠️  No se especificó ruta. Los componentes se instalarán")
        print(f"     globalmente en ~/.local/share/ia-dev-toolkit/\n")

        print(f"  ¿En qué agente trabajas?\n")
        print(f"    [1] OpenCode")
        print(f"    [2] Claude Code")
        print(f"    [3] Gemini CLI")
        print(f"    [4] Codex")
        print(f"    [5] Otro\n")

        choice = input("  Selección: ").strip()

        if choice == "1":
            project_path = Path.home() / ".opencode"
            print(f"\n  ℹ️  OpenCode seleccionado")
        elif choice in ["2", "3", "4", "5"]:
            print(f"\n  ⚠️  Implementación en curso. Disculpa las molestias.")
            return
        else:
            print(f"  ❌ Selección inválida")
            return

    print(f"\n{'═' * 70}")
    print(f"  📦 INSTALAR COMPONENTES")
    print(f"  📍 Ruta: {project_path}")
    print(f"{'═' * 70}\n")

    if not project_path.exists():
        if non_interactive:
            project_path.mkdir(parents=True, exist_ok=True)
            print(f"  ✅ Directorio creado: {project_path}")
        else:
            create = input(f"  La ruta no existe. ¿Crearla? (s/N): ").strip().lower()
            if create != 's':
