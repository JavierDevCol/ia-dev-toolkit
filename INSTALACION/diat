#!/usr/bin/env python3
"""diat — CLI del instalador modular ia-dev-toolkit (DIAT).

Uso:
    diat                      Ver comandos disponibles
    diat --help   / --h       Ayuda detallada
    diat --version / --v      Versión actual
    diat --install [/ruta]    Instalar componentes (en /ruta o en el directorio actual)
    diat --update  [/ruta]    Actualizar componentes
    diat --status  [/ruta]    Estado del sistema o de un proyecto
    diat --list               Proyectos con componentes instalados
    diat --uninstall          Desinstalar
"""

import os
import re
import sys
from pathlib import Path

# Hacer importable el paquete diatlib (está junto a este script, en el bin)
sys.path.insert(0, str(Path(__file__).resolve().parent))

from diatlib import paths, github, deps, registro, instalar, update, entorno, sac_config
from diatlib import menu
from diatlib import ui

# Skills de la metodología SAC (ciclo de vida de HU + arquitectura/calidad + soporte).
# Nota: validar-ca entra por dependencia de ejecutar-plan.
SAC_SKILLS = [
    "tomar-contexto",                                              # contexto del proyecto
    "iniciar-sprint",                                              # materializa HU del sprint activo
    "refinar-hu", "validar-hu", "planificar-hu", "ejecutar-plan",  # ciclo de vida de HU
    "priorizar-backlog",                                           # orden real de ejecucion (dependencias + prioridad)
    "sincronizar-backlog", "registrar-hallazgo",                   # backlog y hallazgos
    "init-reglas-arquitectonicas", "crear-adr", "analizar-calidad-codigo", "analizar-seguridad",  # arquitectura/calidad
    "git-branch-commit", "bitacora-tecnica",                       # soporte dev
]


# ============================================================
# CACHE
# ============================================================
def ensure_cache():
    """Garantiza que el cache tenga componentes actualizados. Devuelve la ruta o None.
    Compara sha (G4): .ref ya es el canal, la etiqueta solo cambia al bajar."""
    ref = paths.get_ref()
    try:
        remote_sha = github.get_remote_sha()
    except github.RefNotFoundError as e:
        ui.print_error(str(e))
        return None
    cache = paths.get_cache_dir()
    have = (cache / "skills").exists()
    if remote_sha and (registro.get_installed_sha() != remote_sha or not have):
        ui.print_info(f"Descargando componentes (ref: {ref})...")
        try:
            cache = github.download_and_stage()
        except github.DownloadError as e:
            ui.print_error(str(e))
            return None
        registro.save_installed_sha(remote_sha)
        registro.save_installed_ref(ref)
    elif not have:
        ui.print_error("No hay componentes en cache y no hay conexión.")
        return None
    return cache


# ============================================================
# --install
# ============================================================
def _submenu_seeds(ctype, catalog):
    """Devuelve lista de seeds, o None si el usuario eligió Volver/Salir."""
    names = sorted(catalog.get(ctype, []))
    if not names:
        ui.print_warning(f"No hay {ctype} disponibles")
        return None
    options = [(n, n, "") for n in names]
    sel = menu.multiselect(f"{ctype.upper()} DISPONIBLES", options)
    if sel is None:                     # Volver / salir del submenú
        return None
    return [(ctype, n) for n in sel]


def ask_platform():
    """Harness destino (carpeta de plataforma), o None si el usuario sale."""
    return menu.menu_select("¿PARA QUÉ HARNESS?",
                            [(".opencode", "OpenCode", ""), (".claude", "Claude Code", "")])


def _gather_seeds(catalog, platform):
    """Menú principal en bucle. Devuelve (seeds, with_config).
    V/Volver regresa aquí; solo Q en el menú principal cancela."""
    wf_desc = ("Workflows (+ skill exc-workflow-sac automática)" if platform == ".claude"
               else "Workflows (+ plugins + commands automáticos)")
    main_options = [
        ("skills", "Skills", "Seleccionar skills específicas"),
        ("agents", "Agents", "Seleccionar agentes específicos"),
        ("workflows", "Workflows", wf_desc),
        ("team_sac", "Team Dev SAC", "Stack SAC: agentes + workflows + skills SAC + config"),
        ("kit", "Kit Completo", "TODO el repo (incl. skills sueltas) + config"),
    ]
    while True:
        choice = menu.menu_select("INSTALADOR MODULAR — ia-dev-toolkit", main_options)
        if choice is None:
            return [], False                        # salir del instalador

        if choice in ("skills", "agents", "workflows"):
            seeds = _submenu_seeds(choice, catalog)
            if seeds is None:                       # Volver -> re-menú
                continue
            if not seeds:                           # ENTER sin marcar nada -> re-menú
                ui.print_info("No marcaste nada. Volviendo al menú...")
                continue
            return seeds, False

        if choice == "team_sac":
            # Stack SAC coherente: el equipo (agentes) + su flujo (workflows) +
            # las skills de la metodología SAC + config.
            seeds = ([("agents", a) for a in catalog.get("agents", set())] +
                     [("workflows", w) for w in catalog.get("workflows", set())] +
                     [("skills", s) for s in SAC_SKILLS if s in catalog.get("skills", set())])
            return seeds, True

        if choice == "kit":
            print(f"\n  Se instalará TODO: "
                  f"{len(catalog.get('agents',[]))} agents, "
                  f"{len(catalog.get('skills',[]))} skills, "
                  f"{len(catalog.get('workflows',[]))} workflows + config")
            if input("  ¿Continuar? (s/N): ").strip().lower() != "s":
                continue                            # volver al menú, no cancelar
            seeds = ([("agents", n) for n in catalog.get("agents", [])] +
                     [("skills", n) for n in catalog.get("skills", [])] +
                     [("workflows", n) for n in catalog.get("workflows", [])])
            return seeds, True


def cmd_install(argv):
    ui.print_banner()

    # 1) Harness primero; 2) destino: ruta explícita o, sin ella, el directorio actual (nunca ~)
    platform = ask_platform()
    if platform is None:
        ui.print_info("Cancelado.")
        return
    args = [a for a in argv if not a.startswith("-")]
    if args:
        project = Path(args[0]).resolve()
    else:
        project = Path.cwd()
        ui.print_warning(f"Sin ruta: se instalará en el directorio actual: {project}")

    cache = ensure_cache()
    if not cache:
        return

    catalog = github.filter_catalog(github.scan_components(cache), platform)
    dependencies = deps.for_platform(platform)

    seeds, with_config = _gather_seeds(catalog, platform)
    if not seeds and not with_config:
        ui.print_info("Nada seleccionado. Cancelado.")
        return

    # Validar SOLO lo seleccionado contra el catálogo de la ref: lo no
    # relacionado con la elección no bloquea (puede pertenecer a otra ref).
    try:
        for w in deps.validate_dependencies(catalog, seeds=seeds,
                                             dependencies=dependencies):
            ui.print_warning(w)
    except deps.DependencyError as e:
        ui.print_error(str(e))
        return

    # Ofrecer solo opcionales que NO estén ya incluidas en lo que se instalará
    # (p. ej. en "Kit Completo" todas las skills ya entran, así que no se ofrece nada)
    _, already = deps.resolve_closure(seeds, dependencies)
    offered = deps.collect_optional(seeds, dependencies)
    opt_options = [(f"{t}:{n}", n, f"opcional ({t})")
                   for t, names in offered.items() for n in names
                   if n not in already.get(t, [])]
    if opt_options:
        extra = menu.multiselect("¿INSTALAR TAMBIÉN? (opcionales)", opt_options)
        for key in (extra or []):
            t, n = key.split(":", 1)
            seeds.append((t, n))

    selection = _seeds_to_dict(seeds, with_config)
    try:
        installed = instalar.install_seeds(seeds, cache, project, platform, with_config=with_config,
                                           dependencies=dependencies)
    except sac_config.SacConfigError as e:
        ui.print_error(str(e))
        return

    remote_sha = registro.get_installed_sha()
    registro.save_installation(project, platform, selection, installed, remote_sha)

    ui.print_success(f"Instalado en {project / platform}")
    print(f"     {sum(len(v) for v in installed.values() if isinstance(v, list))} componentes")


def _seeds_to_dict(seeds, with_config):
    d = {}
    for t, n in seeds:
        d.setdefault(t, [])
        if n not in d[t]:
            d[t].append(n)
    if with_config:
        d["config"] = True
    return d


# ============================================================
# --status  (sistema o proyecto)
# ============================================================
def cmd_status(argv):
    args = [a for a in argv if not a.startswith("-")]
    if args:
        _status_project(Path(args[0]).resolve())
    else:
        _status_system()


def _status_system():
    ui.print_banner()
    print("  🔍 Estado del sistema DIAT\n")
    print(f"  Python:  {sys.version.split()[0]}")
    cache = paths.get_cache_dir()
    print(f"  Cache:   {cache}  {'✅' if cache.exists() else '❌ no existe'}")

    bin_dir = paths.get_bin_path()
    if entorno.is_bin_on_path():
        print(f"  PATH:    ✅ configurado ({bin_dir})")
    else:
        print(f"  PATH:    ⚠️  {bin_dir} no está en PATH — reparando...")
        entorno.ensure_bin_on_path()
        print(f"  PATH:    ✅ reparado")

    local_sha = registro.get_installed_sha()
    ref = paths.get_ref()
    try:
        remote_sha = github.get_remote_sha()
    except github.RefNotFoundError as e:
        ui.print_error(str(e))
        return
    canal = " (canal de prueba)" if paths.is_test_channel(ref) else ""
    print(f"  Ref:     {ref}{canal}")
    if not paths.is_test_channel(ref):
        latest = github.get_latest_release_tag()
        # Solo releases con nombre estable (vX.Y.Z) colorean el canal (B3).
        if latest and re.fullmatch(r"v\d+\.\d+\.\d+", latest):
            extra = " → ejecuta 'diat --update'" if latest != ref else ""
            print(f"  Release: actual {ref} · última {latest}{extra}")
    if remote_sha is None:
        print("  Repo:    ⚠️  sin conexión")
    elif local_sha == remote_sha:
        print(f"  Repo:    ✅ al día ({(local_sha or '?')[:7]})")
    else:
        print(f"  Repo:    ⚠️  hay actualización ({(local_sha or '?')[:7]} → {remote_sha[:7]})")
    print(f"\n  Proyectos registrados: {len(registro.load_installations())}")
    home = Path.home().resolve()
    antiguas = registro.find_installations(home)
    if antiguas:                                    # la instalación global ya no se admite
        plats = ", ".join(i["platform"] for i in antiguas)
        ui.print_warning(f"Instalación global antigua en {home} ({plats}): ya no se admite. "
                         "Quítala con 'diat --uninstall ~' e instala por proyecto.")


def _status_project(project):
    ui.print_banner()
    installs = registro.find_installations(project)
    if not installs:
        ui.print_info(f"{project} no tiene componentes DIAT registrados.")
        return
    try:
        remote_sha = github.get_remote_sha()
    except github.RefNotFoundError as e:
        ui.print_error(str(e))
        return
    print(f"  📦 Estado de {project}\n")
    for inst in installs:                           # una por plataforma (harness)
        print(f"     Plataforma:  {inst['platform']}")
        print(f"     Ref:         {inst.get('ref', 'main')}")
        print(f"     Instalado:   {inst.get('installed_at', '?')}")
        local_sha = inst.get("sha")
        if remote_sha and local_sha == remote_sha:
            estado = "✅ al día"
        elif remote_sha:
            estado = f"⚠️  desactualizado ({(local_sha or '?')[:7]} → {remote_sha[:7]})"
        else:
            estado = "⚠️  sin conexión"
        print(f"     Estado:      {estado}\n")
        comps = inst.get("components", {})
        for ctype in ("agents", "workflows", "skills", "plugins", "tools", "commands"):
            names = comps.get(ctype, [])
            if names:
                print(f"     {ctype} ({len(names)}): {', '.join(names)}")
        if comps.get("config"):
            print("     config: ✅")
        print()


# ============================================================
# --list
# ============================================================
def cmd_list():
    ui.print_banner()
    installs = registro.load_installations()
    if not installs:
        ui.print_info("No hay instalaciones registradas.")
        print("     Usa `diat --install /ruta/proyecto` para empezar.")
        return
    try:
        remote_sha = github.get_remote_sha()
    except github.RefNotFoundError as e:
        ui.print_error(str(e))
        return
    print(f"  📋 {len(installs)} proyecto(s) con DIAT:\n")
    for inst in installs:
        path = inst["project_path"]
        comps = inst.get("components", {})
        total = sum(len(v) for v in comps.values() if isinstance(v, list))
        if not Path(path).exists():
            flag = "❌ no encontrado"
        elif remote_sha and inst.get("sha") == remote_sha:
            flag = "✅ al día"
        elif remote_sha:
            flag = "⚠️  desactualizado"
        else:
            flag = "•"
        print(f"  {flag}  {path}")
        print(f"        {total} componentes · {inst['platform']} · {inst['installed_at'][:10]}")
    print()


# ============================================================
# --uninstall  (ruta = proyecto · sin ruta = todo DIAT)
# ============================================================
def cmd_uninstall(argv):
    from diatlib import desinstalar
    ui.print_banner()
    args = [a for a in argv if not a.startswith("-")]
    if args:
        desinstalar.uninstall_project(Path(args[0]).resolve())
    else:
        desinstalar.uninstall_global()


# ============================================================
# ayuda / versión / dispatch
# ============================================================
def cmd_help():
    print(__doc__)


def cmd_version():
    if paths.get_ref_file().exists():
        ref = paths.get_ref()            # valida el formato (B12); puede lanzar ChannelError
        if ref != paths.DEFAULT_REF:     # 'main' = legado -> cae al espejo .version
            print(f"DIAT — ia-dev-toolkit v{ref[1:]} (canal: {ref})")   # B11
            return
    version = registro.get_installed_version()
    if version:
        print(f"DIAT — ia-dev-toolkit v{version}")
    else:
        print("DIAT — ia-dev-toolkit (versión desconocida, ejecuta `diat --update`)")


def main():
    if (os.environ.get("DIAT_REF") or "").strip():            # D7/B2: env no aplica
        ui.print_error(
            "DIAT_REF ya no aplica al CLI: el canal vive en '.ref' y solo el\n"
            "  bootstrap lo cambia. Para cambiar de canal, re-ejecuta el bootstrap\n"
            "  (p. ej. `curl ... | DIAT_REF=vX.Y.Z-TEST bash`) y retira\n"
            "  'export DIAT_REF=...' de tu shell (p. ej. ~/.zshrc).")
        sys.exit(1)
    argv = sys.argv[1:]
    if not argv:
        cmd_help()
        return
    try:
        cmd, rest = argv[0], argv[1:]
        if cmd in ("--help", "--h", "-h"):
            cmd_help()
        elif cmd in ("--version", "--v", "-v"):
            cmd_version()
        elif cmd in ("--install", "--i", "-i"):
            cmd_install(rest)
        elif cmd in ("--update", "--u", "-u"):
            update.cmd_update(rest)
        elif cmd in ("--status", "-s"):
            cmd_status(rest)
        elif cmd in ("--list", "-l"):
            cmd_list()
        elif cmd in ("--uninstall",):
            cmd_uninstall(rest)
        else:
            ui.print_error(f"Comando desconocido: {cmd}")
            cmd_help()
    except paths.ChannelError as e:                           # B4/B12 -> educativo
        ui.print_error(str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
