        elif (script_dir.parent / "ALMA.md").exists():
            root_dir = script_dir.parent
        else:
            print("❌ No se encontró ALMA.md")
            print("   Ejecuta `diat --update` primero")
            return

    install_alma(project_path, root_dir)


def cmd_uninstall():
    """Desinstalar ia-dev-toolkit del sistema."""
    print(f"\n{'═' * 70}")
    print(f"  🗑️  DESINSTALAR IA DEV TOOLKIT")
    print(f"{'═' * 70}\n")

    # Determinar rutas según plataforma
    if platform.system() == "Windows":
        local_app_data = os.environ.get("LOCALAPPDATA")
        if local_app_data:
            diat_path = Path(local_app_data) / "ia-dev-toolkit" / "bin" / "diat"
            diat_bat = Path(local_app_data) / "ia-dev-toolkit" / "bin" / "diat.bat"
            toolkit_home = Path(local_app_data) / "ia-dev-toolkit"
        else:
            print_error("No se pudo determinar LOCALAPPDATA")
            return
    else:
        diat_path = Path.home() / ".local" / "bin" / "diat"
        toolkit_home = Path.home() / ".local" / "share" / "ia-dev-toolkit"

    # Mostrar qué se eliminará
    print(f"  Se eliminarán los siguientes elementos:\n")

    items_to_remove = []
    if platform.system() == "Windows":
        if diat_path.exists():
            print(f"    📄 {diat_path}")
            items_to_remove.append(diat_path)
        if diat_bat.exists():
            print(f"    📄 {diat_bat}")
            items_to_remove.append(diat_bat)
    else:
        if diat_path.exists():
            print(f"    📄 {diat_path}")
            items_to_remove.append(diat_path)

    if toolkit_home.exists():
        print(f"    📁 {toolkit_home}/")
        items_to_remove.append(toolkit_home)

    if not items_to_remove:
        print(f"    ℹ️  No se encontraron elementos para eliminar")
        return

    print(f"\n  ⚠️  Esta acción no se puede deshacer\n")

    confirm = input("  ¿Continuar con la desinstalación? (s/N): ").strip().lower()
    if confirm != 's':
        print(f"\n  ℹ️  Desinstalación cancelada")
        return

    print(f"\n  🗑️  Desinstalando...\n")

    # Eliminar elementos
    import shutil
    for item in items_to_remove:
        try:
            if item.is_file() or item.is_symlink():
                item.unlink()
                print_success(f"Eliminado: {item}")
            elif item.is_dir():
                shutil.rmtree(item)
                print_success(f"Eliminado: {item}/")
        except Exception as e:
            print_error(f"Error al eliminar {item}: {e}")

    # Limpiar PATH (solo en Linux/Mac)
    if platform.system() != "Windows":
        print(f"\n  ℹ️  Limpiando PATH en archivos de shell...")
        for shell_rc in [Path.home() / ".bashrc", Path.home() / ".zshrc", Path.home() / ".bash_profile"]:
            if shell_rc.exists():
                try:
                    content = shell_rc.read_text(encoding="utf-8")
                    if "# ia-dev-toolkit" in content:
                        # Crear backup
                        backup = shell_rc.with_suffix(".bak")
                        backup.write_text(content, encoding="utf-8")

                        # Eliminar líneas
                        lines = content.split("\n")
                        new_lines = [line for line in lines if "# ia-dev-toolkit" not in line and 'export PATH="$HOME/.local/bin:$PATH"' not in line]
                        shell_rc.write_text("\n".join(new_lines), encoding="utf-8")

                        print_success(f"Limpiado: {shell_rc} (backup: {backup})")
                except Exception as e:
                    print_warning(f"No se pudo limpiar {shell_rc}: {e}")

    print(f"\n{'═' * 70}")
    print(f"  ✅ IA DEV TOOLKIT DESINSTALADO CORRECTAMENTE")
    print(f"{'═' * 70}")
    print(f"\n  📍 Para reinstalar:")
    print(f"     curl -fsSL https://raw.githubusercontent.com/JavierDevCol/ia-dev-toolkit/main/INSTALACION/bootstrap/install.sh | bash")
    print(f"\n  ⚠️  Reinicia la terminal para aplicar los cambios\n")


def cmd_analyze_version():
    """Analizar diff y sugerir versión."""
    print(f"\n{'═' * 70}")
    print(f"  🔄 AUTO-VERSIONING")
    print(f"{'═' * 70}\n")

    # Obtener último tag
    last_tag = get_version()
    print(f"  📍 Último tag: v{last_tag}")

    # Obtener diff
    print(f"  📊 Analizando cambios...")

    try:
        # Ejecutar script de análisis
        script_dir = get_temp_repo_path() / "skills" / "auto-versioning" / "scripts"
        if not script_dir.exists():
            script_dir = Path(__file__).parent / "skills" / "auto-versioning" / "scripts"

        analyze_script = script_dir / "analyze-diff.py"
        if analyze_script.exists():
            import subprocess
            result = subprocess.run(
                ["python3", str(analyze_script)],
                capture_output=True,
                text=True,
                timeout=30
            )
            if result.returncode == 0:
                import json
                analysis = json.loads(result.stdout)
                display_analysis(analysis)
                return
        else:
            print(f"  ⚠️  Script analyze-diff.py no encontrado")

    except Exception as e:
        print(f"  ❌ Error al analizar: {e}")

    print(f"  ℹ️  No se pudieron analizar los cambios")


def display_analysis(analysis):
    """Mostrar análisis de versionamiento."""
    print(f"\n  📊 Análisis de diff:")
    print(f"     - Breaking changes: {analysis['changes']['major']}")
    print(f"     - Nuevas funcionalidades: {analysis['changes']['minor']}")
    print(f"     - Correcciones: {analysis['changes']['patch']}")

    if analysis['suggested_version']:
        print(f"\n  🏷️  Versión sugerida: v{analysis['suggested_version']} ({analysis['reason']})")

        confirm = input(f"\n  ¿Crear tag v{analysis['suggested_version']}? (s/N): ").strip().lower()
        if confirm == 's':
            print(f"\n  ✅ Tag v{analysis['suggested_version']} creado")
            # Aquí iría la lógica para crear el tag
        else:
            custom = input(f"  Ingrese versión personalizada (Enter para cancelar): ").strip()
            if custom:
                print(f"\n  ℹ️  Usando versión: v{custom}")
    else:
        print(f"\n  ℹ️  {analysis['reason']}")


