        tools = []
        for item in tools_dir.iterdir():
            if item.is_file() and item.suffix in (".ts", ".js", ".py", ".sh"):
                tools.append(item.stem)
            elif item.is_dir():
                for script in item.glob("*"):
                    if script.is_file() and script.suffix in (".ts", ".js", ".py", ".sh"):
                        tools.append(script.stem)
