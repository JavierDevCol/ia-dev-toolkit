def get_temp_repo_path():
    if platform.system() == "Windows":
        local_app_data = os.environ.get("LOCALAPPDATA")
        if local_app_data:
            return Path(local_app_data) / "ia-dev-toolkit"
        return Path.home() / "AppData" / "Local" / "ia-dev-toolkit"
    return Path.home() / ".local" / "share" / "ia-dev-toolkit"


def get_installations_file():
    """Obtener ruta del archivo de instalaciones."""
    return get_temp_repo_path() / "instalacion.json"


def load_installations():
    """Cargar instalaciones desde JSON."""
    import json
    installations_file = get_installations_file()
    if not installations_file.exists():
        return []
    try:
        data = json.loads(installations_file.read_text(encoding="utf-8"))
        return data.get("installations", [])
    except Exception:
        return []


def save_installation(project_path, platform_dir, components):
    """Guardar una instalación en el JSON."""
    import json
    from datetime import datetime

    installations_file = get_installations_file()
    installations_file.parent.mkdir(parents=True, exist_ok=True)

    installations = load_installations()

    existing_idx = None
    for i, inst in enumerate(installations):
        if inst["project_path"] == str(project_path):
            existing_idx = i
            break

    new_install = {
        "project_path": str(project_path),
        "platform": platform_dir,
        "installed_at": datetime.now().isoformat(),
        "components": components
    }

    if existing_idx is not None:
        installations[existing_idx] = new_install
    else:
        installations.append(new_install)

    data = {
        "version": get_installed_version(),
        "last_update": datetime.now().isoformat(),
        "installations": installations
    }
    installations_file.write_text(json.dumps(data, indent=2), encoding="utf-8")


def update_installations_version(version):
    """Actualizar versión en todas las instalaciones."""
    import json
    from datetime import datetime

    installations_file = get_installations_file()
    if not installations_file.exists():
        return

    try:
        data = json.loads(installations_file.read_text(encoding="utf-8"))
        data["version"] = version
        data["last_update"] = datetime.now().isoformat()
        installations_file.write_text(json.dumps(data, indent=2), encoding="utf-8")
    except Exception:
        pass


def reinstall_components(installation, cache_path):
    """Reinstalar componentes desde cache al proyecto."""
    import shutil
    project_path = Path(installation["project_path"])
    platform_dir = installation.get("platform", ".opencode")
    components = installation.get("components", {})

    if not project_path.exists():
        print(f"  ⚠️  Proyecto no encontrado: {project_path}")
        return False

    installed = {"tools": 0, "commands": 0, "skills": 0}

    # Tools
    cache_tools = cache_path / "tools"
    project_tools = project_path / platform_dir / "tools"
    if cache_tools.exists():
        project_tools.mkdir(parents=True, exist_ok=True)
        for item in cache_tools.iterdir():
            if item.is_file() and item.suffix in (".ts", ".js", ".py", ".sh"):
                dst = project_tools / item.name
                if not dst.exists():
                    shutil.copy2(item, dst)
                    installed["tools"] += 1
            elif item.is_dir() and item.name == "scripts":
                scripts_dst = project_tools / "scripts"
                scripts_dst.mkdir(exist_ok=True)
                for script in item.iterdir():
                    if script.is_file() and script.suffix in (".ts", ".js", ".py", ".sh"):
                        dst = scripts_dst / script.name
                        if not dst.exists():
                            shutil.copy2(script, dst)
                            installed["tools"] += 1

    # Commands
    cache_commands = cache_path / "commands"
    project_commands = project_path / platform_dir / "commands"
    if cache_commands.exists():
        project_commands.mkdir(parents=True, exist_ok=True)
        for item in cache_commands.iterdir():
            if item.is_file() and item.suffix == ".md":
                dst = project_commands / item.name
                if not dst.exists():
                    shutil.copy2(item, dst)
                    installed["commands"] += 1

    # Skills (symlinks)
    cache_skills = cache_path / "skills"
    project_skills = project_path / platform_dir / "skills"
    if cache_skills.exists() and project_skills.exists():
        for item in cache_skills.iterdir():
            if item.is_dir():
                dst = project_skills / item.name
                if not dst.exists():
                    dst.symlink_to(item)
                    installed["skills"] += 1

    total = sum(installed.values())
    if total > 0:
        print(f"  ✅ Instalados: {installed['tools']} tools, {installed['commands']} commands, {installed['skills']} skills")
    else:
        print(f"  ✅ Todos los componentes están actualizados")

    return True


def ensure_instalar():
    """Asegurar que instalar.py existe localmente, descargar si no."""
    script_dir = get_script_directory()
    instalar_path = script_dir / "instalar.py"

    # Siempre descargar desde GitHub para obtener la versión más reciente
    print("📥 Descargando instalar.py...")
    import urllib.request

    instalar_url = "https://raw.githubusercontent.com/JavierDevCol/ia-dev-toolkit/main/INSTALACION/instalar.py"

    try:
        # Crear directorio si no existe
        script_dir.mkdir(parents=True, exist_ok=True)

        # Descargar
        req = urllib.request.Request(instalar_url, headers={"User-Agent": "diat-cli"})
        response = urllib.request.urlopen(req, timeout=30)
        content = response.read()

        # Guardar
        instalar_path.write_bytes(content)
        print("✅ instalar.py descargado")
        return str(script_dir)
    except Exception as e:
        print(f"❌ Error al descargar instalar.py: {e}")

        # Fallback: usar versión local si existe
        if instalar_path.exists():
            print("⚠️  Usando versión local de instalar.py")
            return str(script_dir)
        return None


