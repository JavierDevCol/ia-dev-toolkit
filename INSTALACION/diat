def get_version():
    """Obtener versión desde Git Tags (GitHub API). Fallback a hardcodeado."""
    try:
        import urllib.request
        import json

        url = "https://api.github.com/repos/JavierDevCol/ia-dev-toolkit/tags"
        req = urllib.request.Request(url, headers={"User-Agent": "diat-cli"})
        response = urllib.request.urlopen(req, timeout=5)
        tags = json.loads(response.read())

        if tags:
            return tags[0]["name"].lstrip("v")
    except Exception:
        pass

    return VERSION


def print_version():
    version = get_version()
    print(f"diat v{version} ({TOOLKIT_NAME})")


def get_script_directory():
    return Path(__file__).parent.absolute()


def get_root_directory():
    return get_script_directory().parent


def get_temp_repo_path():
    if platform.system() == "Windows":
        local_app_data = os.environ.get("LOCALAPPDATA")
        if local_app_data:
            return Path(local_app_data) / TOOLKIT_NAME / "repo"
        return Path.home() / "AppData" / "Local" / TOOLKIT_NAME / "repo"
    return Path.home() / ".local" / "share" / TOOLKIT_NAME / "repo"


def ensure_instalar():
    """Asegurar que instalar.py existe localmente, descargar si no."""
    script_dir = get_script_directory()
    instalar_path = script_dir / "instalar.py"

    # Si ya existe localmente
    if instalar_path.exists():
        return str(script_dir)

    # Si estamos en el repo, buscar en directorio padre
    root_dir = get_root_directory()
    instalar_in_repo = root_dir / "INSTALACION" / "instalar.py"
    if instalar_in_repo.exists():
        return str(root_dir / "INSTALACION")

    # Descargar instalar.py
    print("📥 Descargando instalar.py...")
    import urllib.request

    instalar_url = "https://raw.githubusercontent.com/JavierDevCol/ia-dev-toolkit/main/INSTALACION/instalar.py"

    try:
        # Crear directorio si no existe
        script_dir.mkdir(parents=True, exist_ok=True)

        # Descargar
        req = urllib.request.Request(instalar_url, headers={"User-Agent": "diat-cli"})
        response = urllib.request.urlopen(req, timeout=30)
        content = response.read()

        # Guardar
        instalar_path.write_bytes(content)
        print("✅ instalar.py descargado")
        return str(script_dir)
    except Exception as e:
        print(f"❌ Error al descargar instalar.py: {e}")
        return None


