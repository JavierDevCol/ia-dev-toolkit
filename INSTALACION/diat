def get_installed_version_file():
    """Obtener ruta del archivo que guarda la versión instalada."""
    return Path.home() / ".local" / "share" / TOOLKIT_NAME / ".installed_version"


def get_installed_version():
    """Obtener versión instalada desde archivo local."""
    version_file = get_installed_version_file()
    if version_file.exists():
        return version_file.read_text().strip()
    # Si no hay archivo, la versión instalada es la remota (recién instalado)
    return get_remote_version() or "0.0.0"


def save_installed_version(version):
    """Guardar versión instalada en archivo local."""
    version_file = get_installed_version_file()
    version_file.parent.mkdir(parents=True, exist_ok=True)
    version_file.write_text(version)


def get_update_check_file():
    """Obtener ruta del archivo de timestamp de verificación."""
    return Path.home() / ".local" / "share" / TOOLKIT_NAME / ".last_update_check"


def should_check_for_updates():
    """Verificar si es hora de comprobar actualizaciones."""
    check_file = get_update_check_file()
    if not check_file.exists():
        return True

    try:
        import time
        last_check = float(check_file.read_text().strip())
        return (time.time() - last_check) > UPDATE_CHECK_INTERVAL
    except Exception:
        return True


def save_update_check_timestamp():
    """Guardar timestamp de la última verificación."""
    import time
    check_file = get_update_check_file()
    check_file.parent.mkdir(parents=True, exist_ok=True)
    check_file.write_text(str(time.time()))


def get_remote_version():
    """Obtener versión remota desde GitHub API."""
    try:
        import urllib.request
        import json

        url = "https://api.github.com/repos/JavierDevCol/ia-dev-toolkit/tags"
        req = urllib.request.Request(url, headers={"User-Agent": "diat-cli"})
        response = urllib.request.urlopen(req, timeout=5)
        tags = json.loads(response.read())

        if tags:
            return tags[0]["name"].lstrip("v")
    except Exception:
        pass
    return None


def compare_versions(local, remote):
    """Comparar versiones semánticas. Retorna: 1 si remote > local, 0 si iguales, -1 si local > remote."""
    try:
        local_parts = [int(x) for x in local.split(".")]
        remote_parts = [int(x) for x in remote.split(".")]

        for l, r in zip(local_parts, remote_parts):
            if r > l:
                return 1
            elif l > r:
                return -1

        if len(remote_parts) > len(local_parts):
            return 1
        elif len(local_parts) > len(remote_parts):
            return -1

        return 0
    except Exception:
        return 0


def check_for_updates(silent=False):
    """Verificar si hay actualizaciones disponibles."""
    if "--no-update-check" in sys.argv:
        return

    if not should_check_for_updates():
        return

    if not silent:
        print("🔍 Verificando actualizaciones...")

    remote_version = get_remote_version()
    save_update_check_timestamp()

    if not remote_version:
        if not silent:
            print("  ⚠️  No se pudo verificar versión remota")
        return

    installed_version = get_installed_version()
    comparison = compare_versions(installed_version, remote_version)

    if comparison == 1:
        print(f"\n  🆕 Nueva versión disponible: {remote_version} (actual: {installed_version})")
        print(f"  📥 Ejecuta 'diat --update' para actualizar\n")
    elif not silent:
        print(f"  ✅ Versión actual: {installed_version} (última disponible)")


def auto_update():
    """Actualizar automáticamente diat sin interacción del usuario."""
    remote_version = get_remote_version()
    if not remote_version:
        return False

    installed_version = get_installed_version()
    comparison = compare_versions(installed_version, remote_version)
    if comparison != 1:
        return False

    print(f"🔄 Auto-actualizando de {installed_version} a {remote_version}...")

    diat_path = Path(__file__).resolve()
    diat_url = "https://raw.githubusercontent.com/JavierDevCol/ia-dev-toolkit/main/INSTALACION/diat"

    try:
        import urllib.request

        # Descargar nueva versión
        req = urllib.request.Request(diat_url, headers={"User-Agent": "diat-cli"})
        response = urllib.request.urlopen(req, timeout=30)
        new_diat = response.read()

        # Guardar backup
        backup_path = diat_path.with_suffix(".bak")
        backup_path.write_bytes(diat_path.read_bytes())

        # Actualizar
        diat_path.write_bytes(new_diat)
        diat_path.chmod(0o755)

        # Guardar versión instalada
        save_installed_version(remote_version)
        print(f"✅ diat actualizado a v{remote_version}")
        return True
    except Exception as e:
        print(f"⚠️  Error al auto-actualizar: {e}")
        return False

