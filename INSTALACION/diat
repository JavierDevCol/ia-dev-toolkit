        skills = [d.name for d in skills_dir.iterdir() if d.is_dir() and (d / "SKILL.md").exists()]
        print(f"\n  🔧 SKILLS ({len(skills)}):")
        for s in sorted(skills):
            print(f"     → {s}")

    # Agents
    agents_dir = root_dir / "agents"
    if agents_dir.exists():
        agents = [f.stem for f in agents_dir.glob("*.md")]
        print(f"\n  👤 AGENTES ({len(agents)}):")
        for a in sorted(agents):
            print(f"     → {a}")

    # Workflows
    workflows_dir = root_dir / "workflows"
    if workflows_dir.exists():
        workflows = [d.name for d in workflows_dir.iterdir() if d.is_dir() and (d / "workflow.md").exists()]
        print(f"\n  📋 WORKFLOWS ({len(workflows)}):")
        for w in sorted(workflows):
            print(f"     → {w}")

    # Tools
    tools_dir = root_dir / "tools"
