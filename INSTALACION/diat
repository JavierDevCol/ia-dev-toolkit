def show_menu():
    """Mostrar menú de comandos disponibles."""
    version = get_version()
    print(f"""
╔═══════════════════════════════════════════════════════════════╗
║                    diat — IA Dev Toolkit CLI v{version}         ║
╚═══════════════════════════════════════════════════════════════╝

Comandos disponibles:

  diat --help              Mostrar ayuda detallada
  diat --version           Mostrar versión actual
  diat --check             Verificar requisitos del sistema
  diat --install [/ruta]   Instalar componentes en proyecto
  diat --update [/ruta]    Actualizar componentes en proyecto
  diat --status [/ruta]    Mostrar estado de instalación
  diat --list              Listar componentes en cache
  diat --alma [/ruta]      Instalar personalidad del agente
  diat --analyze-version   Analizar diff y sugerir versión
  diat --uninstall         Desinstalar ia-dev-toolkit

Ejemplos:
  diat --install                    # Instalar en ruta actual
  diat --install /home/user/proy    # Instalar en ruta específica
  diat --update                     # Actualizar ruta actual
  diat --update /home/user/proy     # Actualizar ruta específica
  diat --analyze-version            # Analizar cambios para versión
""")


def main():
    # Sin argumentos → mostrar menú de comandos
    if len(sys.argv) == 1:
        print_banner()
        show_menu()
        return

    # Verificar flag --non-interactive
    non_interactive = "--non-interactive" in sys.argv or "-ni" in sys.argv
    if non_interactive:
        sys.argv.remove("--non-interactive") if "--non-interactive" in sys.argv else sys.argv.remove("-ni")

    # Procesar argumentos
    arg = sys.argv[1]

    if arg in ("--help", "-h"):
        print_banner()
        print_help()

    elif arg in ("--version", "-v"):
        print_version()

    elif arg in ("--list", "-l"):
        print_banner()
        cmd_list()

    elif arg in ("--check", "-c"):
        print_banner()
        cmd_check()

    elif arg in ("--update", "-u"):
        print_banner()
        cmd_update()

    elif arg in ("--status", "-s"):
        print_banner()
        cmd_status()

    elif arg in ("--install", "-i"):
        print_banner()
        cmd_install()

    elif arg in ("--alma", "-a"):
        print_banner()
        cmd_alma()

    elif arg in ("--uninstall", "-U"):
        print_banner()
        cmd_uninstall()

    elif arg in ("--analyze-version", "-av"):
        print_banner()
        cmd_analyze_version()

    elif arg.startswith("-"):
        print(f"❌ Opción desconocida: {arg}")
        print(f"   Usa `diat --help` para ver las opciones disponibles")
        sys.exit(1)

    else:
        # Asumir que es una ruta → instalar
        instalar_dir = ensure_instalar()
        if not instalar_dir:
            print("❌ No se pudo obtener instalar.py")
            sys.exit(1)
        sys.path.insert(0, instalar_dir)
        from instalar import main as install_main
        sys.argv = [sys.argv[0]] + sys.argv[1:]  # Pasar ruta como argumento
        install_main()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n  Operación cancelada por el usuario.")
        sys.exit(0)
