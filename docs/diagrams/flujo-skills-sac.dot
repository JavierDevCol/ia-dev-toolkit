  cargar [label="Cargar HU.md +\nRefinamiento/\nRefinamientoBug"];
  aprobada [label="¿✅ Aprobada?", shape=diamond, fillcolor="#F5A623"];
  error [label="Error: ejecutar\n>validar_hu primero", fillcolor="#D0021B", fontcolor=white];

  ambiguedades [label="¿Ambigüedades\n(tech/rutas/decisiones)?", shape=diamond, fillcolor="#F5A623"];
  pausar [label="PAUSAR", fillcolor="#D0021B", fontcolor=white];

  fases [label="Seleccionar fases\nsegún arquitectura\n(Hexagonal/MVC/Capas/...)"];
  diseno [label="Diseñar componentes,\ninterfaces, contratos"];

  particionada [label="Modo Particionada:\nextraer tasks +\ndependencias", fillcolor="#50E3C2"];
  plana [label="Modo Plano:\nordenar EJEC-01..N\npor dependencias", fillcolor="#50E3C2"];

  generar [label="Generar Plan.md\n(+ Plan.md por task\nsi Particionada)"];
  backbone [label="Backbone\n[A] → [P]"];
