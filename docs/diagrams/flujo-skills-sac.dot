  start -> cargar -> aprobada;
  aprobada -> error [label="No"];
  aprobada -> ambiguedades [label="Sí"];
  ambiguedades -> pausar [label="Sí"];
  ambiguedades -> fases [label="No"];

  fases -> diseno;
  diseno -> particionada;
  diseno -> plana;
  particionada -> generar;
  plana -> generar;
  generar -> backbone -> fin;
}

// ejecutar-plan — Fuente: skills/ejecutar-plan/SKILL.md (Decision Flow oficial).
digraph skill_ejecutar_plan {
  rankdir=LR
  node [fontname="Helvetica" fontsize=10]

  start [label="HU PENDIENTE" shape=ellipse style=filled fillcolor="#4A90D9" fontcolor=white]
  q1 [label="¿HU planificada\nen Plan.md?" shape=diamond style=filled fillcolor="#F5A623"]
  stop [label="→ planificar_hu\nprimero" shape=box style=filled fillcolor="#D0021B" fontcolor=white]
  q2 [label="¿Modo?" shape=diamond style=filled fillcolor="#F5A623"]
  completo [label="completo\nTodo sin pausas" shape=box style=filled fillcolor="#7ED321"]
  fase [label="fase_por_fase\nPausa entre fases" shape=box style=filled fillcolor="#7ED321"]
  tarea [label="tarea_por_tarea\nPausa por tarea" shape=box style=filled fillcolor="#7ED321"]
  task [label="task_por_task\nPausa entre tasks" shape=box style=filled fillcolor="#7ED321"]
  especifica [label="task_especifica\n1 task (requiere --task_id)" shape=box style=filled fillcolor="#9B59B6"]
  q3 [label="¿HU\nparticionada?" shape=diamond style=filled fillcolor="#F5A623"]
  degr1 [label="⚠ Degrada a\ntask_por_task" shape=box style=filled fillcolor="#F5A623"]
  err [label="⛔ Error\nHU plana" shape=box style=filled fillcolor="#D0021B" fontcolor=white]

  start -> q1
  q1 -> stop [label="No" color=red]
  q1 -> q2 [label="Sí"]
  q2 -> completo
  q2 -> fase
  q2 -> tarea
  q2 -> task
  q2 -> especifica
  fase -> q3 [label="¿Particionada?"]
  task -> q3 [label="¿Particionada?"]
  q3 -> degr1 [label="No" color=orange]
  q3 -> task [label="Sí"]
  especifica -> q3
  q3 -> err [label="No" color=red]
  q3 -> especifica [label="Sí\n(requiere --task_id)"]
}

// validar-ca — Fuente: skills/validar-ca/SKILL.md (flowchart oficial de la skill).
digraph skill_validar_ca {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  start [label="Iniciar", shape=oval, style=filled, fillcolor="#4A90D9", fontcolor=white];
  load [label="Cargar\nfuentes", shape=box, style=filled, fillcolor="#7BC67E"];
  scope [label="Scope?", shape=diamond, style=filled, fillcolor="#F5A623"];

  granular [label="CAs granulares\nde la task", shape=box, style=filled, fillcolor="#50E3C2"];
  integration [label="CAs de\nintegración", shape=box, style=filled, fillcolor="#50E3C2"];
  all [label="Todos\nlos CAs", shape=box, style=filled, fillcolor="#50E3C2"];

  evaluate [label="Evaluar CADA CA\ncontra el código\n(sin detenerse)", shape=box, style=filled, fillcolor="#7BC67E"];
  verdict [label="Veredicto\npor CA", shape=diamond, style=filled, fillcolor="#F5A623"];
  ok [label="✅ CUMPLIDO\nmarca [X]", shape=box, style=filled, fillcolor="#7ED321"];
  partial [label="⚠️ PARCIAL\ndeja [ ]", shape=box, style=filled, fillcolor="#F8E71C"];
  fail [label="❌ NO CUMPLIDO\ndeja [ ]", shape=box, style=filled, fillcolor="#D0021B", fontcolor=white];

  update_plan [label="Actualizar\nPlan.md", shape=box, style=filled, fillcolor="#7BC67E"];
  task_done [label="TASK completa?", shape=diamond, style=filled, fillcolor="#F5A623"];
  ca_candidate [label="CA integración\ncandidato [~]", shape=box, style=filled, fillcolor="#BD10E0", fontcolor=white];
  confirm_scope [label="--scope\nintegracion?", shape=diamond, style=filled, fillcolor="#F5A623"];
  hu_complete [label="HU completada\n[X]", shape=box, style=filled, fillcolor="#7ED321"];

  update_ref [label="Actualizar\nRefinamiento.md", shape=box, style=filled, fillcolor="#7BC67E"];
  report [label="Emitir reporte\ncon TODOS los CAs", shape=box, style=filled, fillcolor="#4A90D9", fontcolor=white];

  start -> load -> scope;
  scope -> granular [label="granulares"];
  scope -> integration [label="integracion"];
  scope -> all [label="todos"];

  granular -> evaluate;
  integration -> evaluate;
  all -> evaluate;

  evaluate -> verdict [label="por cada CA"];
  verdict -> ok [label="cumple"];
  verdict -> partial [label="cumple a medias"];
  verdict -> fail [label="no cumple"];

  ok -> update_plan;
  partial -> update_plan;
  fail -> update_plan;

  update_plan -> task_done;
  task_done -> ca_candidate [label="Sí"];
  task_done -> update_ref [label="No"];
  ca_candidate -> confirm_scope;
  confirm_scope -> hu_complete [label="Sí"];
  confirm_scope -> update_ref [label="No"];

  update_ref -> report;
  hu_complete -> report;
}

// sincronizar-backlog — Fuente: skills/sincronizar-backlog/SKILL.md (flowchart oficial de la skill).
digraph skill_sincronizar_backlog {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  start [label="Iniciar", shape=oval, style=filled, fillcolor="#4A90D9", fontcolor=white];
  scan [label="Escanear\nartefactos", shape=box, style=filled, fillcolor="#7BC67E"];
  plan_exists [label="Refinamiento:\n¿Aprobación /\nBloqueo / Plan.md?", shape=diamond, style=filled, fillcolor="#F5A623"];
  plan_status [label="Estado\nPlan.md", shape=diamond, style=filled, fillcolor="#F5A623"];

  pending [label="[ ] Pendiente\nSin refinamiento", shape=box, style=filled, fillcolor="#D0021B", fontcolor=white];
  refined [label="[R] Refinada\nSin Aprobación", shape=box, style=filled, fillcolor="#BD10E0", fontcolor=white];
  approved [label="[A] Aprobada\n✅ Aprobada", shape=box, style=filled, fillcolor="#4A90D9", fontcolor=white];
  planned [label="[P] Planificada\nPENDIENTE", shape=box, style=filled, fillcolor="#50E3C2"];
  running [label="[E] En Ejecución\nEN_PROGRESO", shape=box, style=filled, fillcolor="#F8E71C"];
  done [label="[X] Completada\nCOMPLETADO", shape=box, style=filled, fillcolor="#7ED321"];
  blocked [label="[B] Bloqueada\nBLOQUEADO", shape=box, style=filled, fillcolor="#D0021B", fontcolor=white];

  start -> scan;
  scan -> plan_exists;
  plan_exists -> pending [label="No existe\nRefinamiento"];
  plan_exists -> refined [label="Sin Aprobación,\nsin Bloqueo"];
  plan_exists -> blocked [label="Con\n## Bloqueo de\nValidación"];
  plan_exists -> approved [label="Con\n✅ Aprobada"];
  plan_exists -> plan_status [label="Aprobada,\ncon Plan.md"];
  plan_status -> planned [label="PENDIENTE"];
  plan_status -> running [label="EN_PROGRESO"];
  plan_status -> done [label="COMPLETADO"];
  plan_status -> blocked [label="BLOQUEADO"];
}